# ─────────────────────────────────────────────────────────────────────────────
# stockflow API — environment variables. Copy to .env (never commit .env).
# The server validates these at startup and refuses to boot if something
# required is missing or unsafe (e.g. placeholder secrets in production).
# ─────────────────────────────────────────────────────────────────────────────

# ---- Server ----
NODE_ENV=development
PORT=4000
# HOST=0.0.0.0                 # bind address (default 0.0.0.0)

# Frontend origin(s) allowed by CORS, comma-separated. Required in production.
# FRONTEND_URL is accepted as an alias.
CLIENT_ORIGIN=http://localhost:5173

# Number of reverse proxies in front of the API (default: 0 in dev, 1 in production).
# Render = 1; Vercel /api rewrite → Render = 2.
# TRUST_PROXY=1

# Public self-registration (POST /auth/register). Default: on in dev, OFF in production.
# ALLOW_REGISTRATION=false

# ---- Database (PostgreSQL) ----
# Local docker-compose database:
DATABASE_URL=postgresql://stockflow:stockflow@localhost:5432/stockflow?schema=public
# Neon (production) — use the connection string from the Neon console, with SSL:
# DATABASE_URL=postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<db>?sslmode=require

# ---- Auth ----
# Two DIFFERENT long random values. Generate with: openssl rand -hex 32
# In production they must be >= 32 characters and not placeholders.
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# ---- Demo seed (npm run seed / npm run seed:prod) ----
# Required to seed when NODE_ENV=production — only for a public demo database.
# SEED_DEMO_DATA=true
# Password for the three demo accounts (default: Password123! — local use only).
# SEED_DEMO_PASSWORD=
