# Base URL of the stockflow API (no trailing slash). Only public values belong here:
# every VITE_* variable is embedded in the browser bundle.
#
# Local development:
VITE_API_URL=http://localhost:4000/api/v1
#
# Production on Vercel — pick ONE:
#  (recommended) leave VITE_API_URL unset and point the /api rewrite in vercel.json
#                at your Render URL → requests are same-origin, cookies are first-party.
#  (direct)      VITE_API_URL=https://<your-render-service>.onrender.com/api/v1
#                and set CLIENT_ORIGIN on the API to your Vercel URL. Some browsers
#                block third-party cookies, so sessions may not survive a page reload.
